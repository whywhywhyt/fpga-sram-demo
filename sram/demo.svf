TRST OFF;
ENDIR IDLE;
ENDDR IDLE;
STATE RESET;
STATE IDLE;
FREQUENCY 1.00e+06 HZ;
TDR 0 ;
TIR 0 ;
HDR 0 ;
HIR 0 ;
//Disable Dual boot loop. 
SIR 8 TDI (80) ;
SDR 64 TDI (00800000000000a5) ;
RUNTEST 200 TCK ;
//Loading device with 'bypass' instruction. 
SIR 8 TDI (ff) ;
SIR 8 TDI (ff) ;
//Loading device with 'idcode' instruction.
SIR 8 TDI (06) ;
RUNTEST 15 TCK ;
SDR 32 TDI (00000000) TDO (4808F0E7) MASK (FFFFFFFF) ;
//Boundary Scan Chain Contents
//Loading device with 'refresh' instruction.
SIR 8 TDI (01) ;
//Loading device with 'bypass' & 'spi_program' instruction.
SIR 8 TDI (FF) ;
SIR 8 TDI (39) ;
RUNTEST 120000 TCK ;
//Loading device with 'jtag program' instruction.
SIR 8 TDI (30) ;
RUNTEST 1000 TCK ;
//Loading device with a `cfg_in` instruction.
SIR 8 TDI (3b) ;
RUNTEST 1000 TCK ;
SDR 14313088 TDI () ;
RUNTEST 100 TCK ;
//Loading device with a `jtag start` instruction.
SIR 8 TDI (32) ;
RUNTEST 1000 TCK ;
RUNTEST 15 TCK ;
//Loading device with 'bypass' instruction.
SIR 8 TDI (FF) ;
RUNTEST 1000 TCK ;
SIR 8 TDI (31) ;
RUNTEST 1000 TCK ;
SIR 8 TDI (32) ;
RUNTEST 15 TCK ;
SIR 8 TDI (FF) ;
RUNTEST 15 TCK ;
SIR 8 TDI (80) ;
SDR 64 TDI (00000000000000a5) ;
RUNTEST 200 TCK ;
